<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title><%= pageTitle || 'Login' %></title>
  <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
</head>
<body class="bg-light">
  <div class="container py-4">
    <h1 class="mb-3">Login</h1>

    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

    <form method="post" action="/login-<%= SID %>" class="row g-3" novalidate>
      <div class="col-md-6">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" required
               value="<%= form?.email || '' %>">
      </div>
      <div class="col-md-6">
        <label class="form-label">Password</label>
        <input name="password" type="password" class="form-control" required minlength="8">
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-primary">Login</button>
        <a class="btn btn-outline-secondary" href="/register-<%= SID %>">Create an account</a>
      </div>
    </form>
  </div>
</body>
</html>
