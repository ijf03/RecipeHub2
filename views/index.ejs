<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles.css">

  </head>

  <body class="bg-light">
    <!-- Navbar -->
    <%- include('partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <!-- Hero / Greeting -->
      <section class="section">
        <div class="hero shadow-sm">
          <% if (currentUser) { %>
            <h1 class="mb-1">Welcome, <span class="fw-semibold"><%= currentUser.fullName %></span></h1>
            <p class="text-secondary mb-0"><%= currentUser.email %></p>
            <p class="text-muted mt-2 mb-0">Here’s a quick snapshot of your kitchen.</p>
          <% } else { %>
            <h1 class="mb-2">Welcome to <span class="fw-semibold">Recipe Hub</span></h1>
            <p class="text-secondary mb-3">Browse recipes and inventory. Log in to add your own.</p>
            <div class="d-flex gap-2">
              <a class="btn btn-primary" href="/login-<%= SID %>">Log in</a>
              <a class="btn btn-outline-secondary" href="/register-<%= SID %>">Register</a>
            </div>
          <% } %>
        </div>
      </section>

      <!-- Stats -->
      <section class="section">
        <div class="row g-3">

          <div class="col-12 col-md-4">
            <div class="card stat-card h-100">
              <div class="card-body text-center">
                <h6 class="text-uppercase text-muted mb-2">Users</h6>
                <p class="stat-value"><%= userCount %></p>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-4">
            <div class="card stat-card h-100">
              <div class="card-body text-center">
                <h6 class="text-uppercase text-muted mb-2">Recipes</h6>
                <% if (currentUser && typeof myRecipeCount === 'number') { %>
                  <p class="stat-value"><%= myRecipeCount %> / <%= recipeCount %></p>
                  <small class="text-muted">My Recipes / Total</small>
                <% } else { %>
                  <p class="stat-value"><%= recipeCount %></p>
                <% } %>
              </div>
            </div>
          </div>

          <div class="col-12 col-md-4">
            <div class="card stat-card h-100">
              <div class="card-body text-center">
                <h6 class="text-uppercase text-muted mb-2">Inventory Items</h6>
                <p class="stat-value"><%= inventoryCount %></p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Primary CTAs -->
      <section class="section">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <a class="btn btn-primary w-100 py-3"
               href="/recipes-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
              View Recipes
            </a>
          </div>
          <div class="col-12 col-md-6">
            <a class="btn btn-outline-primary w-100 py-3"
               href="/inventory-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
              View Inventory
            </a>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
