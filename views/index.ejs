<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light">
    <%- include('partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <div class="row m-4">
        <h1 class="mb-3">Welcome, <%= name %> (<%= studentId %>)</h1>
        <p class="text-muted">Plan meals, manage ingredients, and browse your cookbook.</p>
      </div>

      <div class="row m-4">
        <div class="col-md-6"><a class="btn btn-primary w-100 py-3" href="/recipes/list-<%= SID %>">View Recipes</a></div>
        <div class="col-md-6"><a class="btn btn-outline-primary w-100 py-3" href="/inventory/list-<%= SID %>">View Inventory</a></div>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
