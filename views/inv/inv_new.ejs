<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <h1 class="h1 mb-4">Add New Item</h1>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST" action="/add-inventory-<%= SID %>" class="row g-3">
        <div class="col-md-12">
          <label class="form-label">Ingredient Name</label>
          <input name="ingredientName" class="form-control" required minlength="3" value="<%= form?.ingredientName || '' %>" placeholder=" e.g. Chocolate Chips">
        </div>
        

        <div class="col-md-4">
          <label class="form-label">Quantity</label>
          <input name="quantity" class="form-control" required minlength="1" value="<%= form?.quantity || '' %>" placeholder=" e.g. 2">
        </div>

        <div class="col-md-4">
          <label class="form-label">Unit</label>
          <select name="unit" class="form-select" required>
            <option value="">=== Unit ===</option>
              <% (units || []).forEach(function(u){ %>
                <option value="<%= u %>" <%= (form && form.unit === u) ? 'selected' : '' %>><%= u %></option>
              <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Category</label>
          <select name="category" class="form-select" required>
            <option value="">=== Category ===</option>
              <% (categories || []).forEach(function(c){ %>
                <option value="<%= c %>" <%= (form && form.category === c) ? 'selected' : '' %>><%= c %></option>
              <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Purchase Date</label>
          <input type="date" name="purchaseDate" class="form-control" value="<%= form?.purchaseDate || '' %>">
        </div>

        <div class="col-md-4">
          <label class="form-label">Expiration Date</label>
          <input type="date" name="expirationDate" class="form-control" value="<%= form?.expirationDate || '' %>">
        </div>

        <div class="col-md-4">
          <label class="form-label">Location</label>
          <select name="location" class="form-select" required>
            <option value="">=== Location ===</option>
              <% (locations || []).forEach(function(l){ %>
                <option value="<%= l %>" <%= (form && form.location === l) ? 'selected' : '' %>><%= l %></option>
              <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Cost</label>
          <input name="cost" class="form-control" required minlength="1" value="<%= form?.cost || '' %>" placeholder=" e.g. 5.99">
        </div>

        <div class="col-12">
          <button class="btn btn-primary">Save Item</button>
          <a class="btn btn-secondary" href="/recipes-<%= SID %>">Cancel</a>
        </div>
      </form>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
