<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 m-0"><%= item.ingredientName %></h1>
        <a class="btn btn-outline-secondary" href="/inventory-<%= SID %>">Back to Inventory</a>
      </div>

      <div class="row g-4 mb-1">
        <div class="col-12">
          <div class="card shadow-sm">
            <div class="card-header">Details</div>
            <div class="card-body">
              <div class="row g-3">
                <div class="col-md-6 col-xl-4">
                  <dl class="row mb-0">
                    <dt class="col-5 col-sm-4">Inventory ID</dt>
                    <dd class="col-7 col-sm-8"><code class="text-danger"><%= item.inventoryId %></code></dd>

                    <dt class="col-5 col-sm-4">Quantity</dt>
                    <dd class="col-7 col-sm-8"><%= item.quantity %> <%= item.unit %></dd>

                    <dt class="col-5 col-sm-4">Category</dt>
                    <dd class="col-7 col-sm-8"><%= item.category %></dd>
                  </dl>
                </div>

                <div class="col-md-6 col-xl-4">
                  <dl class="row mb-0">
                    <dt class="col-5 col-sm-4">Purchased</dt>
                    <dd class="col-7 col-sm-8"><%= item.purchaseDate %></dd>

                    <dt class="col-5 col-sm-4">Expires</dt>
                    <dd class="col-7 col-sm-8"><%= item.expirationDate %></dd>

                    <dt class="col-5 col-sm-4">Location</dt>
                    <dd class="col-7 col-sm-8"><%= item.location %></dd>
                  </dl>
                </div>

                <div class="col-md-6 col-xl-4">
                  <dl class="row mb-0">
                    <dt class="col-5 col-sm-4">Cost (AU$)</dt>
                    <dd class="col-7 col-sm-8">$<%= Number(item.cost).toFixed ? Number(item.cost).toFixed(2) : item.cost %></dd>

                    <dt class="col-5 col-sm-4">Created</dt>
                    <dd class="col-7 col-sm-8"><%= item.createdDate %></dd>
                  </dl>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
