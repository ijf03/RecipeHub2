<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../../public/styles.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h1 m-0">Edit Inventory Item</h1>
        <a class="btn btn-outline-secondary"
           href="/inventory-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
          Back to Inventory
        </a>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST"
            action="/inventory/edit-<%= SID %>/<%= form?.inventoryId %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>"
            class="row g-3">

        <input type="hidden" name="userId" value="<%= userIdParam %>">
        <input type="hidden" name="inventoryId" value="<%= form?.inventoryId %>">

        <div class="col-md-12">
          <label class="form-label">Ingredient Name</label>
          <input name="ingredientName"
                 class="form-control track-change"
                 required minlength="2" maxlength="50"
                 value="<%= form?.ingredientName || '' %>"
                 data-original="<%= form?.ingredientName || '' %>"
                 placeholder=" e.g. Chocolate Chips">
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Quantity</label>
          <input name="quantity"
                 type="number" min="0.01" step="0.01"
                 class="form-control track-change"
                 required
                 value="<%= form?.quantity || '' %>"
                 data-original="<%= form?.quantity || '' %>"
                 placeholder=" e.g. 2">
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Unit</label>
          <select name="unit" class="form-select track-change" required
                  data-original="<%= form?.unit || '' %>">
            <option value="">=== Unit ===</option>
            <% (units || []).forEach(function(u){ %>
              <option value="<%= u %>" <%= (form && form.unit === u) ? 'selected' : '' %>><%= u %></option>
            <% }) %>
          </select>
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Category</label>
          <select name="category" class="form-select track-change" required
                  data-original="<%= form?.category || '' %>">
            <option value="">=== Category ===</option>
            <% (categories || []).forEach(function(c){ %>
              <option value="<%= c %>" <%= (form && form.category === c) ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Purchase Date</label>
          <input type="date" name="purchaseDate"
                 class="form-control track-change"
                 required
                 value="<%= form?.purchaseDate || '' %>"
                 data-original="<%= form?.purchaseDate || '' %>">
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Expiration Date</label>
          <input type="date" name="expirationDate"
                 class="form-control track-change"
                 required
                 value="<%= form?.expirationDate || '' %>"
                 data-original="<%= form?.expirationDate || '' %>">
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Location</label>
          <select name="location" class="form-select track-change" required
                  data-original="<%= form?.location || '' %>">
            <option value="">=== Location ===</option>
            <% (locations || []).forEach(function(l){ %>
              <option value="<%= l %>" <%= (form && form.location === l) ? 'selected' : '' %>><%= l %></option>
            <% }) %>
          </select>
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-md-4">
          <label class="form-label">Cost</label>
          <input name="cost"
                 type="number" min="0.01" step="0.01"
                 class="form-control track-change"
                 required
                 value="<%= form?.cost || '' %>"
                 data-original="<%= form?.cost || '' %>"
                 placeholder=" e.g. 5.99">
          <small class="form-text text-muted original-hint"></small>
        </div>

        <div class="col-12">
          <button class="btn btn-primary">Save Changes</button>
          <a class="btn btn-secondary"
             href="/inventory-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
            Cancel
          </a>
        </div>
      </form>
    </main>

    <%- include('../partials/footer') %>

    <script>
    (function () {
        function normalize(v) { return (v ?? '').toString().trim(); }
        document.querySelectorAll('.track-change').forEach(function(el){
        var orig = normalize(el.getAttribute('data-original'));
        var hint = el.parentElement.querySelector('.original-hint'); 
        function update() {
            var now = normalize(el.value);
            var changed = now !== orig;

            el.classList.toggle('is-changed', changed);
            el.classList.toggle('border-warning', changed);
            el.classList.toggle('bg-warning-subtle', changed);

            if (hint) {
            if (changed) {
                hint.textContent = 'original: ' + orig;
                hint.style.display = 'block';
            } else {
                hint.textContent = '';
                hint.style.display = 'none';
            }
            }
        }
        el.addEventListener('input', update);
        el.addEventListener('change', update);
        update();
        });
    })();
    </script>
  </body>
</html>
