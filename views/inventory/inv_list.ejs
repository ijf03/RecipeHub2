<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <h1 class="display-6 mb-1">All Inventory Items</h1>
          <p class="text-muted m-0">Browse and manage your pantry items.</p>
        </div>
        <span class="badge text-bg-secondary">
          <%= (inventory && inventory.length) ? inventory.length : 0 %> items
        </span>
      </div>

      <div class="mb-3">
        <a class="btn btn-primary me-2" href="/inventory/new-<%= SID %>">+ Add Inventory Item</a>
      </div>

      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <form method="GET" action="/inventory/list-<%= SID %>" class="row g-2 align-items-end" id="invFilters">
            <% const F = (typeof filters !== 'undefined' && filters) || {}; %>
            <div class="col-12 col-md-4">
              <label for="q" class="form-label">Search</label>
              <input id="q" name="q" class="form-control"
                    placeholder="Search"
                    value="<%= F.q || '' %>">
            </div>

            <div class="col-6 col-md-2">
              <label for="category" class="form-label">Category</label>
              <select id="category" name="category" class="form-select">
                <option value="">All</option>
                <% categories.forEach(c => { %>
                  <option value="<%= c %>" <%= (F.category===c?'selected':'') %>><%= c %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-md-2">
              <label for="location" class="form-label">Location</label>
              <select id="location" name="location" class="form-select">
                <option value="">All</option>
                <% locations.forEach(l => { %>
                  <option value="<%= l %>" <%= (F.location===l?'selected':'') %>><%= l %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-md-1">
              <button type="submit" class="btn btn-primary w-100">Apply</button>
            </div>
            <div class="col-6 col-md-1">
              <a href="/inventory/list-<%= SID %>" class="btn btn-outline-secondary">Clear</a>
            </div>
          </form>
        </div>
      </div>

      <% if (!inventory || inventory.length === 0) { %>
        <div class="alert alert-info">No inventory yet. Click “Add Inventory Item”.</div>
      <% } else { %>
        <div class="card shadow-sm">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped align-middle m-0">
                <thead class="table-light">
                  <tr>
                    <th>Inventory ID</th>
                    <th>Name</th>
                    <th>Quantity</th>
                    <th>Unit</th>
                    <th>Category</th>
                    <th>Location</th>
                    <!-- Icon taken from https://icons8.com/icons/set/sort -->
                    <th class="sortable" onclick="sortTable('expirationDate')">
                      Expiration Date <img width="10" height="10" src="https://img.icons8.com/ios-glyphs/30/sort.png" alt="sort"/>
                    </th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const i of inventory) { %>
                    <tr>
                      <td><code class="text-danger"><%= i.inventoryId %></code></td>
                      <td><strong><%= i.ingredientName %></strong></td>
                      <td><%= i.quantity %></td>
                      <td><%= i.unit %></td>
                      <td><%= i.category %></td>
                      <td><%= i.location %></td>
                      <td data-exp="<%= i.expirationDate || '' %>">
                        <% 
                          const expISO = i.expirationDate; 
                          let badge = '';
                          if (expISO) {
                            const startOfDay = d => new Date(d.getFullYear(), d.getMonth(), d.getDate());
                            const today = startOfDay(new Date());
                            const exp = startOfDay(new Date(expISO));
                            const diffDays = Math.ceil((exp - today) / (1000*60*60*24));
                            if (diffDays < 0) {
                              badge = '<span class="badge text-bg-danger ms-2">Expired</span>';
                            } else if (diffDays <= 7) {
                              badge = `<span class="badge text-bg-warning text-dark ms-2">Expiring in ${diffDays}d</span>`;
                            }
                          }
                        %>
                        <%= i.expirationDate || '-' %> <%- badge %>
                      </td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary me-2" href="/inventory/view-<%= SID %>/<%= i.inventoryId %>">View</a>

                        <form method="POST" action="/inventory/delete-<%= SID %>/<%= i.inventoryId %>" class="d-inline"
                              onsubmit="return confirm('Delete ' + <%- JSON.stringify(i.ingredientName || 'this item') %> + '?');">
                          <input type="hidden" name="inventoryId" value="<%= i.inventoryId %>">
                          <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <td colspan="9" class="text-end small text-muted px-3">
                      Latest created:
                      <code><%= inventory.map(i => i.createdDate).sort().slice(-1)[0] %></code>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </main>
    <%- include('../partials/footer') %>


    <script>
    (function () {
      function setIndicator(th, dir) { // changes the sort from ascending to descending evry time its pressed
        const span = th.querySelector('.sort-indicator');
        th.dataset.sort = dir === 1 ? 'asc':'desc';
      }

      function rowValue(tr) { // get the value of the row to be sorted
        const td = tr.querySelector('td[data-exp]'); //get the expiration date
        const iso = (td && td.dataset.exp) ? td.dataset.exp.trim(): ''; //set format of the date
        if (!iso) return Number.POSITIVE_INFINITY; // missing dates set as inf
        const d = new Date(iso); // convert to date object
        return isNaN(d) ? Number.POSITIVE_INFINITY : d.getTime(); // return time or inf if invalid
      }

      window.sortTable = function (key) { // main function to sort the table
        if (key !== 'expirationDate') return;

        const table = document.querySelector('table.table');
        if (!table) return;

        const ths = table.tHead ? Array.from(table.tHead.rows[0].cells) : []; //get tble header
        const th = ths.find(el => el.classList.contains('sortable')) || null; //find the header with sortable class

        const current = th ? th.dataset.sort : "none"; // get current sort direction
        const dir =current=== 'asc' ? -1 : 1; //change direction
        if (th) setIndicator(th, dir);  //set indicator
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.rows);

        rows.sort((a, b) => { // compare each of the rows
          const av = rowValue(a);
          const bv = rowValue(b);
          const aMissing = !isFinite(av), bMissing = !isFinite(bv);
          if (aMissing && bMissing) return 0;
          if (aMissing)return 1;
          if (bMissing)return -1;
          return (av-bv) * dir;
        });

        rows.forEach(r => tbody.appendChild(r));
      };
    })();
    </script>
  </body>
</html>