<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h1 m-0">Add New Item</h1>
        <a class="btn btn-outline-secondary"
           href="/inventory-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
          Back to Inventory
        </a>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST"
            action="/inventory/add-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>"
            class="row g-3">

        <input type="hidden" name="userId" value="<%= userIdParam %>">

        <div class="col-md-12">
          <label class="form-label">Ingredient Name</label>
          <input name="ingredientName"
                 class="form-control"
                 required minlength="2" maxlength="50"
                 value="<%= form?.ingredientName || '' %>"
                 placeholder=" e.g. Chocolate Chips">
        </div>

        <div class="col-md-4">
          <label class="form-label">Quantity</label>
          <input name="quantity"
                 type="number" min="0.01" step="0.01"
                 class="form-control" required
                 value="<%= form?.quantity || '' %>"
                 placeholder=" e.g. 2">
        </div>

        <div class="col-md-4">
          <label class="form-label">Unit</label>
          <select name="unit" class="form-select" required>
            <option value="">=== Unit ===</option>
            <% (units || []).forEach(function(u){ %>
              <option value="<%= u %>" <%= (form && form.unit === u) ? 'selected' : '' %>><%= u %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Category</label>
          <select name="category" class="form-select" required>
            <option value="">=== Category ===</option>
            <% (categories || []).forEach(function(c){ %>
              <option value="<%= c %>" <%= (form && form.category === c) ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Purchase Date</label>
          <input type="date" name="purchaseDate" class="form-control" required
                 value="<%= form?.purchaseDate || '' %>">
        </div>

        <div class="col-md-4">
          <label class="form-label">Expiration Date</label>
          <input type="date" name="expirationDate" class="form-control" required
                 value="<%= form?.expirationDate || '' %>">
        </div>

        <div class="col-md-4">
          <label class="form-label">Location</label>
          <select name="location" class="form-select" required>
            <option value="">=== Location ===</option>
            <% (locations || []).forEach(function(l){ %>
              <option value="<%= l %>" <%= (form && form.location === l) ? 'selected' : '' %>><%= l %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Cost</label>
          <input name="cost"
                 type="number" min="0.01" step="0.01"
                 class="form-control" required
                 value="<%= form?.cost || '' %>"
                 placeholder=" e.g. 5.99">
        </div>

        <div class="col-12">
          <button class="btn btn-primary">Save Item</button>
          <a class="btn btn-secondary"
             href="/inventory-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
            Cancel
          </a>
        </div>
      </form>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>