<nav class="navbar navbar-expand-md bg-body-tertiary fixed-top">
  <div class="container-fluid">

    <a class="navbar-brand d-flex align-items-center" href="/<%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
      <img src="/images/RecipeHubLogo.png" alt="Logo" width="30" height="30" class="me-2">
      Recipe Hub
    </a>

    <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link <%= (typeof pageTitle !== 'undefined' && pageTitle === 'Home') ? 'active' : '' %>"
            aria-current="page"
            href="/<%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
            Home
          </a>
        </li>
        
        <% if (currentUser && currentUser.role === 'chef') { %>
          <li class="nav-item">
            <a class="nav-link"
              href="/recipes-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
              Recipes
            </a>
          </li>
        <% } %>

        <% if (currentUser) { %>
          <li class="nav-item">
            <a class="nav-link"
              href="/inventory-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
              Inventory
            </a>
          </li>
        <% } %>

       <li class="nav-item">
          <% if (currentUser) { %>
            <a class="nav-link" href="/logout-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
              Logout (<%= currentUser.fullName %>)
            </a>
          <% } else { %>
            <a class="nav-link" href="/login-<%= SID %>">Login</a>
          <% } %>
        </li>
      </ul>
    </div>
  </div>
</nav>
