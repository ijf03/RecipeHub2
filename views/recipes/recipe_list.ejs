<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>

    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
          <h1 class="display-6 mb-1">All Recipes</h1>
          <p class="text-muted m-0">Discover and manage your culinary collection</p>
        </div>
        <span class="badge text-bg-secondary"><%= recipes?.length || 0 %> recipes</span>
      </div>

      <div class="mb-3">
        <a class="btn btn-primary me-2" href="/add-recipe-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">+ Add New Recipe</a>

      </div>

      <div class="card mb-3 shadow-sm">
        <div class="card-body">
          <form method="GET" action="/recipes-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
              <label for="q" class="form-label">Search</label>
              <input id="q" name="q" class="form-control"
                    placeholder="Title, chef, or ingredient"
                    value="<%= filters?.q || '' %>">
            </div>

            <div class="col-6 col-md-2">
              <label for="meal" class="form-label">Meal</label>
              <select id="meal" name="meal" class="form-select">
                <option value="">All</option>
                <% mealTypes.forEach(m => { %>
                  <option value="<%= m %>" <%= (filters?.meal===m?'selected':'') %>><%= m %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-md-2">
              <label for="cuisine" class="form-label">Cuisine</label>
              <select id="cuisine" name="cuisine" class="form-select">
                <option value="">All</option>
                <% cuisines.forEach(c => { %>
                  <option value="<%= c %>" <%= (filters?.cuisine===c?'selected':'') %>><%= c %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-md-2">
              <label for="difficulty" class="form-label">Difficulty</label>
              <select id="difficulty" name="difficulty" class="form-select">
                <option value="">All</option>
                <% difficulties.forEach(d => { %>
                  <option value="<%= d %>" <%= (filters?.difficulty===d?'selected':'') %>><%= d %></option>
                <% }) %>
              </select>
            </div>

            <div class="col-6 col-md-1">
              <button type="submit" class="btn btn-primary w-100">Apply</button>
            </div>
            <div class="col-6 col-md-1">
              <a href="/recipes-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>" class="btn btn-outline-secondary">Clear</a>
            </div>
          </form>
        </div>
      </div>

      <% if (!recipes || recipes.length === 0) { %>
        <div class="alert alert-info">No recipes yet. Click “Add New Recipe”.</div>
      <% } else { %>
        <div class="card shadow-sm">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped align-middle m-0">
                <thead class="table-light">
                  <tr>
                    <th>Recipe ID</th>
                    <th>Title</th>
                    <th>Chef</th>
                    <th>Meal Type</th>
                    <th>Cuisine</th>
                    <th>Difficulty</th>
                    <th>Prep Time</th>
                    <th>Servings</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% for (const r of recipes) { %>
                    <tr>
                      <td><code class="text-danger"><%= r.recipeId %></code></td>
                      <td><strong><%= r.title %></strong></td>
                      <td><%= r.chef %></td>
                      <td>
                        <span class="badge text-bg-primary"><%= r.mealType %></span>
                      </td>
                      <td><%= r.cuisineType %></td>
                      <td>
                        <% if (r.difficulty === 'Easy') { %>
                          <span class="badge text-bg-success">Easy</span>
                        <% } else if (r.difficulty === 'Medium') { %>
                          <span class="badge text-bg-warning text-dark">Medium</span>
                        <% } else { %>
                          <span class="badge text-bg-danger">Hard</span>
                        <% } %>
                      </td>
                      <td><%= r.prepTime %> min</td>
                      <td><%= r.servings %></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary me-1"
                          href="/recipe/<%= r.recipeId %>-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
                          View
                        </a>

                        <a class="btn btn-sm btn-outline-primary me-1"
                          href="/recipe/edit-<%= SID %>/<%= r.recipeId %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">
                          Edit
                        </a>

                        <form method="POST"
                              action="/recipe/delete-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>"
                              class="d-inline"
                              onsubmit="return confirm('Delete <%= r.title.replace(/'/g,'&apos;') %>?')">
                          <input type="hidden" name="recipeId" value="<%= r.recipeId %>">
                          <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                      </td>
                    </tr>
                  <% } %>
                </tbody>
                <tfoot class="table-light">
                  <tr>
                    <td colspan="9" class="text-end small text-muted px-3">
                      Created dates: latest 
                      <code><%= recipes.map(r => r.createdDate).sort().slice(-1)[0] %></code>
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        </div>
      <% } %>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>