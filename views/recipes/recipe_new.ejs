<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
  </head>
  <body class="bg-light d-flex flex-column min-vh-100">
    <%- include('../partials/nav') %>

    <main class="container" style="margin-top:4.5rem">
      <h1 class="h1 mb-4">Add New Recipe</h1>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form method="POST" action="/recipes/add-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>" class="row g-3">
        <input type="hidden" name="userId" value="<%= userIdParam %>">
        <div class="col-md-6">
          <label class="form-label">Recipe Title*</label>
          <input name="title" class="form-control" required minlength="3" value="<%= form?.title || '' %>" placeholder=" e.g. Chocolate Chip Cookies">
        </div>

        <div class="col-md-6">
          <label class="form-label">Chef Name*</label>
          <input name="chef" class="form-control" required
                value="<%= form?.chef || '' %>" placeholder="e.g. Gordon Ramsay">
        </div>

        <% if (currentUser) { %>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="isMine" name="isMine"
                    <%= form?.isMine ? 'checked' : '' %>>
              <label class="form-check-label" for="isMine">
                This recipe is mine (<%= currentUser.fullName %>)
              </label>
            </div>
          </div>

          <script>
            (function () {
              var box = document.getElementById('isMine'); // checks if the is mine box is checked
              var chef = document.querySelector('input[name="chef"]');
              if (!box || !chef) return;
              var myName = "<%= currentUser.fullName %>";

              function sync() { // makes the chef feild readonly if box is checked
                if (box.checked) {
                  chef.value = myName;
                  chef.readOnly = true;
                  chef.required = false;
                } else {
                  if (chef.value === myName) chef.value = "";
                  chef.readOnly = false;
                  chef.required = true;
                }
              }
              box.addEventListener('change', sync);
              sync();
            })();
          </script>
        <% } %>


        <div class="col-md-6">
          <label class="form-label">Meal Type*</label>
          <select name="mealType" class="form-select" required>
            <option value="">=== Meal Type ===</option>
              <% (mealTypes || []).forEach(function(mt){ %>
                <option value="<%= mt %>" <%= (form && form.mealType === mt) ? 'selected' : '' %>><%= mt %></option>
              <% }) %>
          </select>
        </div>

        <div class="col-md-6">
          <label class="form-label">Cuisine Type*</label>
          <select name="cuisineType" class="form-select" required>
           <option value="">=== Cuisine Type ===</option>
            <% (cuisines || []).forEach(function(c){ %>
              <option value="<%= c %>" <%= (form && form.cuisineType === c) ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Prep Time (mins)*</label>
          <input name="prepTime" type="number" min="1" step="1" class="form-control" required
                 value="<%= form?.prepTime || '' %>"
                 placeholder="e.g. 30 minutes">
        </div>

        <div class="col-md-4">
          <label class="form-label">Difficulty Level*</label>
          <select name="difficulty" class="form-select" required>
            <option value="">=== difficulty ===</option>
              <% (difficulties || []).forEach(function(d){ %>
                <option value="<%= d %>" <%= (form && form.difficulty === d) ? 'selected' : '' %>><%= d %></option>
              <% }) %>
          </select>
        </div>

        <div class="col-md-4">
          <label class="form-label">Servings*</label>
          <input name="servings" type="number" min="1" step="1" class="form-control" required
                 value="<%= form?.servings || '' %>"
                 placeholder="e.g. 4 servings">
        </div>


        <h2 class="h2">Ingredients</h2>
        <div class="col-12">
          <textarea name="ingredients" class="form-control" rows="5" required
                    placeholder="List ingredients here. enter each ingredient on a separate line or separated by commas.
                    - 2 cups all purpose flour
                    - 1 cup sugar
                    - 1/2 cup butter
                    - 3 eggs
                    - 1 tsp vanilla extract
                    - 2 cups chocolate chips
                    "><%= form?.ingredients || '' %></textarea>
        </div>

        <h2 class="h2">Instructions</h2>
        <div class="col-12">
          <textarea name="instructions" class="form-control" rows="5" required
                    placeholder="Enter step by step instructions separated by commas or a new line.
                    1. Preheat oven to 350C
                    2. Mix ingredients in a bowl
                    3. Bake for 30 minutes
                    "><%= form?.instructions || '' %></textarea>
        </div>

        <div class="col-12">
          <button class="btn btn-primary">Save Recipe</button>
          <a class="btn btn-secondary" href="/recipes-<%= SID %><%= userIdParam ? ('?userId=' + userIdParam) : '' %>">Cancel</a>
        </div>
      </form>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
